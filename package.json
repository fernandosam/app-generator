{
  "name": "app-generator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:layout": "playwright test",
    "layout:audit": "node scripts/audit-layout.mjs",
    "ui:install": "bash scripts/install-coss.sh",
    "skills:install": "bash scripts/install-skills.sh",
    "check:static": "node scripts/check-static.mjs",
    "layout:compare": "node scripts/compare-layouts.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "check": "vp build && vp check --deny-warnings",
    "check:harness": "node scripts/check-harness-independence.mjs",
    "layout:verify-visual": "node scripts/verify-visual-review.mjs",
    "analysis:check": "node scripts/check-analysis.mjs",
    "verify": "npm run check:static && npm run check:harness && npm run test:unit && npm run check && npm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@daypicker/react": "10.0.1",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
