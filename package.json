{
  "name": "app-generator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:layout": "playwright test",
    "layout:audit": "node scripts/audit-layout.mjs",
    "ui:install": "bash scripts/install-coss.sh",
    "skills:install": "bash scripts/install-skills.sh",
    "check:static": "node scripts/check-static.mjs",
    "layout:compare": "node scripts/compare-layouts.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "check": "npm run check:static && npm run check:harness && npm run test:unit && npm test && npm run typecheck",
    "check:harness": "node scripts/check-harness-independence.mjs",
    "layout:verify-visual": "node scripts/verify-visual-review.mjs",
    "analysis:check": "node scripts/check-analysis.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "@base-ui/react": "^1.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
